{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mekanto product catalog",
  "type": "object",
  "required": [
    "schemaVersion",
    "store",
    "categories",
    "products"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "store": {
      "type": "object",
      "required": [
        "name",
        "currency",
        "locale",
        "whatsappNumber",
        "whatsappDisplay"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "locale": {
          "type": "string"
        },
        "whatsappNumber": {
          "type": "string",
          "pattern": "^[0-9]{8,15}$"
        },
        "whatsappDisplay": {
          "type": "string"
        },
        "sampleCatalog": {
          "type": "boolean"
        },
        "notice": {
          "type": "string"
        },
        "siteUrl": {
          "type": "string",
          "format": "uri",
          "description": "Public HTTPS site URL used for canonical tags, sitemap.xml and robots.txt."
        }
      },
      "additionalProperties": false
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "shortName": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "imagePosition": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "products": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/product"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "product": {
      "type": "object",
      "required": [
        "id",
        "title",
        "category"
      ],
      "properties": {
        "subtitle": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "material": {
          "type": "string"
        },
        "dimensions": {
          "type": "string"
        },
        "compatibility": {
          "type": "string"
        },
        "includes": {
          "type": "string"
        },
        "badge": {
          "type": "string"
        },
        "imageAlt": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "category": {
          "$ref": "#/$defs/id"
        },
        "categories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "price": {
          "type": "number",
          "minimum": 0
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "Optional extra search terms. Title, description and category are searchable automatically."
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "description": "Optional relative asset path or complete HTTPS image URL. If omitted, a placeholder is shown."
        },
        "imageLayout": {
          "enum": [
            "single",
            "atlas",
            "poster",
            "cutout"
          ],
          "default": "single"
        },
        "imagePosition": {
          "enum": [
            "0% 0%",
            "100% 0%",
            "0% 100%",
            "100% 100%"
          ]
        },
        "featured": {
          "type": "boolean",
          "default": false
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "colors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "hex"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "hex": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            },
            "additionalProperties": false
          }
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Product name shown on the site and in search results."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
